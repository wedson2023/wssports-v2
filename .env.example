APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# conexão contínua do bilhete em tempo real (spec 010): servidor Reverb ("php artisan reverb:start");
# o navegador recebe host, porta e esquema pela página, a cada carga
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=8080

# notificações push (spec 010): gerar com "php artisan notificacoes_push:gerar_chaves"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@seudominio.com.br

JWT_SECRET=

PROVEDOR_COTACOES_URL_PRE_JOGO=https://apiprejogo.wssports.bet/api
PROVEDOR_COTACOES_URL_AO_VIVO=https://apiaovivo.wssports.bet/api
PROVEDOR_COTACOES_URL_CONFERENCIA=https://api.oddbrasil.com/bet/v2
PROVEDOR_COTACOES_CHAVE=
# endereço do site enviado no parâmetro "app"; vazio usa o APP_URL
PROVEDOR_COTACOES_APP=

# cassino (spec 011): provedor TBS2; hall e chave do hall informados pelo provedor. A URL de callback
# a cadastrar no hall é APP_URL/api/cassino/carteira
CASSINO_URL_API=http://tbs2api.aslot.net/API/
CASSINO_HALL=
CASSINO_CHAVE=
CASSINO_ASSINATURA=false
CASSINO_PREFIXO_LOGIN=wss

# Mercado Pago: credenciais da aplicação do programador (conta master); a banca vincula a conta
# dela pelo painel (Configurações > Gateway de pagamentos)
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
# chave privada (PEM) dos saques automáticos (Payouts); vazia = sem assinatura (ambiente de testes)
MERCADO_PAGO_PAYOUTS_CHAVE_PRIVADA=

# robô do WhatsApp pela Evolution API (spec 021): endereço, chave global, instância da banca (vazio =
# domínio do APP_URL) e token secreto dos avisos de conexão (webhook)
EVOLUTION_API_URL=https://evolution.exemplo.test
EVOLUTION_API_CHAVE=1b5cfd434c4e52bf4aa45b904e314a2bd9c168ac1d0e60317a27e16fd36d8be1
EVOLUTION_API_INSTANCIA=wssports-teste
EVOLUTION_WEBHOOK_TOKEN=e6739dc987e2a9b7b55eb255ba20ca527484f5828f22b8e508faf9382859fda1
